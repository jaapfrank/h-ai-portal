ttachments"},{"id":1305,"caption":null,"alternativeText":"Hoeflon multitool with small beam clamp"},{"id":1304,"caption":null,"alternativeText":"Hoeflon multitool with glass suction cup"},{"id":1303,"caption":null,"alternativeText":"Hoeflon multitool with forks"},{"id":1302,"caption":null,"alternativeText":"Hoeflon multitool with beam clamp, lifting a beam"},{"id":1505,"caption":null,"alternativeText":"Hoeflon TC1e maximum load"},{"id":1455,"caption":null,"alternativeText":"Hoeflon TC1e maximum weight"},{"id":1454,"caption":null,"alternativeText":"Hoeflon TC1e platform"},{"id":1453,"caption":null,"alternativeText":"Hoeflon TC1e maximum height"},{"id":1452,"caption":null,"alternativeText":"Hoeflon TC1e maximum load"},{"id":1248,"caption":null,"alternativeText":"Hoeflon-TC1"},{"id":1247,"caption":null,"alternativeText":"Hoeflon-TC1"},{"id":1246,"caption":null,"alternativeText":"Hoeflon-TC1"},{"id":1245,"caption":null,"alternativeText":"Hoeflon-TC1"},{"id":1221,"caption":null,"alternativeText":"Hoeflon Equator"},{"id":1224,"caption":null,"alternativeText":"Hoeflon Equator folded"},{"id":1226,"caption":null,"alternativeText":"Hoeflon Equator"},{"id":1223,"caption":null,"alternativeText":"Hoeflon Equator"},{"id":1222,"caption":null,"alternativeText":"Hoeflon Equator"},{"id":1126,"caption":null,"alternativeText":"Hoeflon Equator"},{"id":1658,"caption":null,"alternativeText":"C30e in working position with partially extended boom, right view"},{"id":1657,"caption":null,"alternativeText":"C30e in working position with partially extended boom, right view"},{"id":1656,"caption":null,"alternativeText":"C30e in working position with partially extended boom, left view"},{"id":1446,"caption":null,"alternativeText":"Hoeflon C30 in pick-and-carry mode"},{"id":1445,"caption":null,"alternativeText":"Hoeflon C30 boom in negative position"},{"id":1444,"caption":null,"alternativeText":"Hoeflon C30 in transport mode on a truck"},{"id":1443,"caption":null,"alternativeText":"Hoeflon C30 winch folding"},{"id":1442,"caption":null,"alternativeText":"Hoeflon C30e with transformer"},{"id":1441,"caption":null,"alternativeText":"Hoeflon C30 maximum height"},{"id":1440,"caption":null,"alternativeText":"Hoeflon C30 articulated boom"},{"id":1189,"caption":null,"alternativeText":"Hoeflon c30"},{"id":1750,"caption":null,"alternativeText":"Two people posing in front of a Hoeflon crane in a workspace."},{"id":1662,"caption":null,"alternativeText":"Handing over a Hoeflon crane at Robert Kappel GmbH."},{"id":1558,"caption":null,"alternativeText":"Groeger Bauaufzüge team photo with crane in the background."},{"id":1557,"caption":null,"alternativeText":"Group photo of employees in blue overalls, outdoors in nature."},{"id":1638,"caption":null,"alternativeText":"Hoeflon crane outside a building with two Fastlift Cranes vehicles."},{"id":1548,"caption":null,"alternativeText":"Group of people with Hoeflon cranes and abuk.pl sign."},{"id":1297,"caption":null,"alternativeText":"Hoeflon crane in the sun, with a truck in the background and trees around."},{"id":1518,"caption":null,"alternativeText":"Various EasX R210 aerial work platforms in a warehouse."},{"id":1296,"caption":null,"alternativeText":"Hoeflon crane in front of a Monitor Lifts building."},{"id":1299,"caption":null,"alternativeText":"Group photo of the Monitor team in red shirts in an office space."},{"id":1300,"caption":null,"alternativeText":"Aerial lift at a building with a monitor sign next to it."},{"id":1301,"caption":null,"alternativeText":"Map of Australia and New Zealand with marked locations."},{"id":1295,"caption":null,"alternativeText":"Hoeflon crane at trade show booth with banner."},{"id":1291,"caption":null,"alternativeText":"Hoeflon crane lifting object at construction site."},{"id":1292,"caption":null,"alternativeText":"Man operating Hoeflon crane in warehouse."},{"id":1290,"caption":null,"alternativeText":"Gergely Metromont, man in a suit, talking on the phone at an exhibition."},{"id":1289,"caption":null,"alternativeText":"Hoeflon crane in action outside, man controls crane with remote panel."},{"id":1288,"caption":null,"alternativeText":"Hoeflon crane outside in front of a building."},{"id":1287,"caption":null,"alternativeText":"Hoeflon crane in an upright position, viewed from above."},{"id":1286,"caption":null,"alternativeText":"Hoeflon crane placing a glass wall in a building from a sloped surface."},{"id":1285,"caption":null,"alternativeText":"Hoeflon crane lifting a glass balcony to a building."},{"id":1284,"caption":null,"alternativeText":"Hoeflon crane with boom reaching an apartment in a building."},{"id":1274,"caption":null,"alternativeText":"Hoeflon C10e crawler crane with high boom for a building."},{"id":1275,"caption":null,"alternativeText":"Hoeflon C30e crawler crane with high boom for a building."},{"id":1277,"caption":null,"alternativeText":"Hoeflon C6e crawler crane."},{"id":1278,"caption":null,"alternativeText":"Hoeflon C10e crawler crane."},{"id":1268,"caption":null,"alternativeText":"Mechanic working on a crane in a workshop."},{"id":1267,"caption":null,"alternativeText":"Hoeflon C10 lifting a large cylinder in a factory hall."},{"id":1260,"caption":null,"alternativeText":"Hoeflon crane at a trade show booth with a Gantic banner."},{"id":1559,"caption":null,"alternativeText":"Map of Norway with Gantic’s service points and machine storage."},{"id":1258,"caption":null,"alternativeText":"Hoeflon C6e crane for the Dunst company."},{"id":1259,"caption":null,"alternativeText":"Dunst team members in traditional attire."},{"id":1254,"caption":null,"alternativeText":"Map of Sweden showing Hoeflon sales and service locations."},{"id":1574,"caption":null,"alternativeText":"Person reviewing a Hoeflon brochure at a trade show."},{"id":1635,"caption":null,"alternativeText":"Hoeflon glass suction device in action at a trade show."},{"id":1633,"caption":null,"alternativeText":"Hoeflon crane lifting an object with a glass suction device at a trade show."},{"id":1634,"caption":null,"alternativeText":"Person reviewing a Hoeflon brochure at a trade show."},{"id":1632,"caption":null,"alternativeText":"Demonstration of the Hoeflon remote control at a trade show."},{"id":1561,"caption":null,"alternativeText":"Discussion at the Hoeflon booth at a trade show."},{"id":1577,"caption":null,"alternativeText":"Hoeflon team members at the Glasstec trade show."},{"id":1560,"caption":null,"alternativeText":"Hoeflon team members at the Glasstec trade show."},{"id":1554,"caption":null,"alternativeText":"Hoeflon cranes at a trade show booth during Batimat 2024."},{"id":1553,"caption":null,"alternativeText":"Hoeflon cranes at a trade show booth during Batimat 2024."},{"id":1466,"caption":null,"alternativeText":"Hoeflon System Lift"},{"id":1465,"caption":null,"alternativeText":"Hoeflon cranes displayed at a trade show booth."},{"id":1464,"caption":null,"alternativeText":"Hoeflon Vertikal Days"},{"id":1463,"caption":null,"alternativeText":"Glasstec logo."},{"id":1462,"caption":null,"alternativeText":"Hoeflon Platformers' Days 2024"},{"id":1563,"caption":null,"alternativeText":"Hoeflon C6 lifting a steel beam in a warehouse."},{"id":1564,"caption":null,"alternativeText":"Hoeflon crane lifting a metal frame in a warehouse."},{"id":1565,"caption":null,"alternativeText":"Hoeflon C6e crane lifting a roof structure in Norway."},{"id":1566,"caption":null,"alternativeText":"Hoeflon crane lifting a concrete staircase with chains."},{"id":1567,"caption":null,"alternativeText":"Hoeflon crane lifting an object with a chain."},{"id":1568,"caption":null,"alternativeText":"Hoeflon mini crane lifting a heavy object at a house."},{"id":1727,"caption":null,"alternativeText":"Hoeflon C10 in action with the glass suction device."},{"id":1569,"caption":null,"alternativeText":"Hoeflon crane working inside a building."},{"id":1253,"caption":null,"alternativeText":"Hoeflon C6 working with the glass suction device."},{"id":1252,"caption":null,"alternativeTe