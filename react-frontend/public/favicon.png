de-producten","title":"Related Products (project detail page)","createdAt":"2024-11-20T12:20:11.253Z","updatedAt":"2025-06-03T19:41:09.194Z","locale":"en","contentSections":[{"id":13,"__component":"sections.related-products","eyebrow":"Related Products","title":"\r\n\r\nFind out which machine suits you.\r\n\r\n","description":null,"categories":{"data":[]}}]}},{"id":76,"attributes":{"internalName":"testimonial-detail-related-products","title":"Related products","createdAt":"2024-11-20T11:12:03.140Z","updatedAt":"2025-06-03T19:44:47.443Z","locale":"en","contentSections":[{"id":9,"__component":"sections.related-products","eyebrow":null,"title":"Related products","description":null,"categories":{"data":[]}}]}},{"id":102,"attributes":{"internalName":"contact-information-no-container","title":"Organization Contact Information (without container)","createdAt":"2024-11-20T12:31:54.097Z","updatedAt":"2024-11-20T12:31:54.097Z","locale":"en","contentSections":[{"id":23,"__component":"sections.contact-information-block","withContainer":false,"withBackground":false,"title":null,"description":null,"small":null,"items":[{"id":55,"title":"Email","description":"For questions or comments, feel free to contact us.","organisationInfo":"e-mailadres","icon":{"data":null}},{"id":56,"title":"Phone","description":"Call us for more information or to schedule an appointment.","organisationInfo":"telefoonnummer","icon":{"data":null}},{"id":57,"title":"Showroom","description":"Visit our showroom for personalized advice and see how we work for yourself.","organisationInfo":"adresgegevens","icon":{"data":null}}]}]}},{"id":30,"attributes":{"internalName":"brochure","title":"Brochure | Discover our cranes today","createdAt":"2024-07-11T07:33:10.684Z","updatedAt":"2024-12-20T07:12:58.884Z","locale":"en","contentSections":[{"id":122,"__component":"sections.image-right","title":"Discover our cranes today","description":"Hoeflon designs, builds and supplies top quality mini cranes.","wide":false,"contact":false,"objectFit":"contain","border":null,"backgroundColor":"Light","buttons":[{"id":153,"url":"/request-brochure","newTab":false,"text":"Receive a brochure","type":"primary","microCopy":null}],"poster":{"data":{"id":1590,"attributes":{"name":"Afbeelding brochure.png","alternativeText":null,"caption":null,"width":2048,"height":1365,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Afbeelding_brochure_2ea1e9c5f6.png","hash":"thumbnail_Afbeelding_brochure_2ea1e9c5f6","mime":"image/png","name":"thumbnail_Afbeelding brochure.png","path":null,"size":27.05,"width":234,"height":156}},"hash":"Afbeelding_brochure_2ea1e9c5f6","ext":".png","mime":"image/png","size":347.63,"url":"/uploads/Afbeelding_brochure_2ea1e9c5f6.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2024-11-01T18:25:56.105Z","updatedAt":"2024-11-01T18:25:56.105Z"}}}}]}},{"id":104,"attributes":{"internalName":"tekstblok-contact-form","title":"Text block two columns (show right of Contact form)","createdAt":"2025-04-03T07:24:01.315Z","updatedAt":"2025-04-03T08:28:31.140Z","locale":"en","contentSections":[{"id":2,"__component":"sections.rich-text-two-columns-block","title":null,"content":"**General**\n- info@hoeflon.com\n- +31 (0)342 400 288\n\nZwolleweg 2  \n3771 NR, Barneveld, NL  \nVAT-ID: NL856539806B01  \nKvK: 66408962\n\n**Sales**\n- sales@hoeflon.com\n- +31 (0)342 400 288\n\n**Administration**\n- administration@hoeflon.com\n- +31 (0)342 400 288\n","titleSecond":null,"contentSecond":"**Purchase**\n- purchase@hoeflon.com\n- +31 (0)342 400 288\n\n**Parts**\n- parts@hoeflon.com\n- +31 (0)342 400 288\n\n**Marketing**\n- marketing@hoeflon.com\n- +31 (0)342 400 288"}]}}],"upcomingEvents":[{"id":39,"attributes":{"publishedAt":"2025-04-23T09:54:19.674Z","title":"Artibat 2025","content":"#### Artibat – The leading construction trade fair for professionals in Western France\n\nFrom October 22–24, 2025, we’ll be attending Artibat in Rennes, France – the trade fair that unveils the latest building trends and brings together construction professionals from Western France.\nTogether with our dealers GK Techniques and Pro2Mat, we’ll showcase our latest solutions for the construction industry. We hope to see you there!\n","startdate":"2025-10-22","enddate":"2025-10-24","maxParticipants":null,"slug":"artibat-2025","registerCount":null,"createdAt":"2025-04-23T09:54:13.521Z","updatedAt":"2025-04-23T10:10:09.288Z","locale":"en","description":"From October 22 to 24, we’ll be at Artibat in Rennes!","showForm":false,"formTitle":null,"formContent":null,"poster":{"data":{"id":1856,"attributes":{"name":"Terrasse2_1040c500.png","alternativeText":null,"caption":null,"width":2048,"height":985,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Terrasse2_1040c500_5c5a6e6d64.png","hash":"thumbnail_Terrasse2_1040c500_5c5a6e6d64","mime":"image/png","name":"thumbnail_Terrasse2_1040c500.png","path":null,"size":73.94,"width":245,"height":118}},"hash":"Terrasse2_1040c500_5c5a6e6d64","ext":".png","mime":"image/png","size":1048.66,"url":"/uploads/Terrasse2_1040c500_5c5a6e6d64.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-04-23T09:44:57.237Z","updatedAt":"2025-04-23T09:44:57.237Z"}}}}},{"id":34,"attributes":{"publishedAt":"2025-04-23T09:30:20.741Z","title":"GIS Expo","content":"#### GIS Expo 2025 – Europe’s largest trade fair for lifting, handling, and heavy transport equipment\n\nFrom September 25–27, 2025, we’ll be at the GIS Expo in Piacenza, Italy – the biggest European event dedicated to users of cranes, mobile cranes, aerial platforms, telehandlers, forklifts, overhead cranes, industrial handling equipment, and heavy transport vehicles.\n\nYou’ll find us at stand 173B and 175, together with our dealer Naiks. We’ll be showcasing our latest machines and smart solutions. We hope to see you there!\n","startdate":"2025-09-25","enddate":"2025-09-27","maxParticipants":null,"slug":"gis-expo","registerCount":null,"createdAt":"2025-04-23T09:29:14.260Z","updatedAt":"2025-04-23T09:37:10.119Z","locale":"en","description":"From September 25 to 27, we’ll be at the GIS Expo in Piacenza!","showForm":false,"formTitle":null,"formContent":null,"poster":{"data":{"id":1855,"attributes":{"name":"LOGO-GIS.png","alternativeText":null,"caption":null,"width":479,"height":324,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_LOGO_GIS_1936a16c86.png","hash":"thumbnail_LOGO_GIS_1936a16c86","mime":"image/png","name":"thumbnail_LOGO-GIS.png","path":null,"size":28.46,"width":231,"height":156}},"hash":"LOGO_GIS_1936a16c86","ext":".png","mime":"image/png","size":60.18,"url":"/uploads/LOGO_GIS_1936a16c86.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-04-23T09:22:47.370Z","updatedAt":"2025-04-23T09:22:47.370Z"}}}}},{"id":29,"attributes":{"publishedAt":"2025-04-23T09:03:51.654Z","title":"JDL Expo 2025","content":"#### JDL Expo – The trade fair for equipment, services, energy, digitalization, and artificial intelligence\n\nFrom September 17–19, 2025, we’ll be attending the JDL Expo in Beaune, France – a key industry event focused on cutting-edge equipment, smart services, sustainable energy, digital innovation, and AI.\nTogether with our dealers GK Techniques and Pro2Mat, we’ll showcase how our latest machines and solutions contribute to the future of the industry. See you there!","startdate":"2025-09-17","enddate":"2025-09-19","maxParticipants":null,"slug":"jdl-expo","registerCount":null,"createdAt":"2025-04-23T09:03:49.791Z","updatedAt":"2025-04-23T09:09:59.264Z","locale":"en","description":"From September 17 to 19, we’ll be at the JDL Expo in Beaune!","showForm":false,"formTitle":null,"formContent":null,"poster":{"data":{"id":1854,"attributes":{"name":"JDL-EXPO-2024-©-JDLGROUPE20.jpg","alternativeText":null,"caption":null,"width":2048,"height":1362,"formats":{"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_JDL_EXPO_2024_JDLGROUPE_20_b64de0733f.jpg","hash":"thumbnail_JDL_EXPO_2024_JDLGROUPE_20_b64de0733f","mime":"image/jpeg","name":"thumbnail_JDL-EXPO-2024-©-JDLGROUPE20.jpg","path":null,"size":13.42,"width":235,"height":156}},"hash":"JDL_EXPO_2024_JDLGROUPE_20_b64de0733f","ext":".jpg","mime":"image/jpeg","size":433.69,"url":"/uploads/JDL_EXPO_2024_JDLGROUPE_20_b64de0733f.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2025-04-23T09:01:35.125Z","updatedAt":"2025-04-23T09:01:35.125Z"}}}}}],"mostVisitedFaqs":[{"id":54,"attributes":{"visit_count":1,"question":"What is the lifespan of a battery? ","answer":"The battery has a long lifespan and can be charged and discharged frequently with minimal reduction in performance. The exact lifespan of the battery depends on its usage.","slug":"what-is-the-lifespan-of-a-battery","createdAt":"2024-11-18T20:18:12.706Z","updatedAt":"2024-11-19T16:15:59.186Z","locale":"en","categories":{"data":[]}}},{"id":58,"attributes":{"visit_count":1,"question":"Which accessories are included with the machine? ","answer":"The following accessories are delivered with a mini crane:\n- Lifting hook\n- Two paint markers\n- Cable for connecting the remote control\n- Steel cable for removing the counterweight\n- Attachment for mounting winch head and 30° angle adapter on main boom\n- Extra roller for the winch cable\n- Helmet\n- Safety vest","slug":"which-accessories-are-included-with-the-machine","createdAt":"2024-11-18T20:19:52.059Z","updatedAt":"2024-11-19T16:25:54.271Z","locale":"en","categories":{"data":[]}}},{"id":62,"attributes":{"visit_count":1,"question":"Does Hoeflon offer mini cranes for hire?","answer":"There are various companies that offer Hoeflon cranes for hire. Hoeflon does not hire out its cranes itself. ","slug":"does-hoeflon-offer-mini-cranes-for-hire","createdAt":"2024-11-18T20:21:15.722Z","updatedAt":"2024-11-19T16:22:21.763Z","locale":"en","categories":{"data":[]}}},{"id":66,"attributes":{"visit_count":1,"question":"Does Hoeflon also sell diesel machines?","answer":"Hoeflon mainly builds fully electric mini cranes and carriers. Contact your dealer or account manager to discuss the options for purchasing a diesel machine.","slug":"does-hoeflon-also-sell-diesel-machines","createdAt":"2024-11-18T20:23:30.630Z","updatedAt":"2024-11-19T16:23:52.204Z","locale":"en","categories":{"data":[]}}},{"id":70,"attributes":{"visit_count":1,"question":"Can you operate and charge at the same time?","answer":"Yes, you can operate and charge at the same time.","slug":"can-you-operate-and-charge-at-the-same-time","createdAt":"2024-11-18T20:24:53.896Z","updatedAt":"2024-11-19T16:20:56.406Z","locale":"en","categories":{"data":[]}}},{"id":74,"attributes":{"visit_count":1,"question":"Do you also sell used mini cranes?","answer":"We offer used cranes on Marktplaats. Check the latest status on our [marktplaatsaccount](https://www.marktplaats.nl/u/hoeflon-international-b-v/25106776/) or contact your dealer or account manager for the most up-to-date information. ","slug":"do-you-also-sell-used-mini-cranes","createdAt":"2024-11-18T20:26:18.284Z","updatedAt":"2024-11-19T16:13:43.168Z","locale":"en","categories":{"data":[]}}},{"id":78,"attributes":{"visit_count":1,"question":"Can the machine be supplied in company colours?","answer":"Yes, our machines can be supplied in your company colours. There are various options available.\nContact your dealer or account manager to discuss the different options. ","slug":"can-the-machine-be-supplied-in-company-colours","createdAt":"2024-11-18T20:27:46.575Z","updatedAt":"2024-11-19T16:17:52.287Z","locale":"en","categories":{"data":[]}}},{"id":82,"attributes":{"visit_count":1,"question":"Can I lease a mini crane?","answer":"Yes, it is possible to acquire a mini crane through a leasing arrangement. Hoeflon works with various partners. Contact your dealer or account manager to discuss the different leasing options. ","slug":"can-i-lease-a-mini-crane","createdAt":"2024-11-18T20:29:21.518Z","updatedAt":"2024-11-19T16:19:36.366Z","locale":"en","categories":{"data":[]}}},{"id":86,"attributes":{"visit_count":1,"question":"Which certificates do I need to operate a Hoeflon crane?","answer":"Each country has its own laws and regulations regarding the certificates required to operate a crane. Contact your local Hoeflon dealer. They can provide you with all the details regarding the laws and regulations for operating our cranes. \n\nIn the Netherlands, no lifting certificate is required for cranes with a capacity up to 10 tonne-metres. Without a lifting certificate, you can operate the Hoeflon C1e, C4e, C6e and C10e. To operate the Hoeflon C30e, you will need a mobile crane operator certificate (TCVT W4-01).","slug":"which-certificates-do-i-need-to-operate-a-hoeflon-crane","createdAt":"2024-11-18T20:30:55.241Z","updatedAt":"2024-11-19T16:27:50.442Z","locale":"en","categories":{"data":[]}}}],"notification":[],"vacancies":[],"mediaLanguages":[{"id":1766,"caption":null,"alternativeText":"Hoeflon C6e BR crane with the boom that automatically unfolds"},{"id":1765,"caption":null,"alternativeText":"Hoeflon C6e BR crane with sliding ballast."},{"id":1764,"caption":null,"alternativeText":"Hoeflon C6e BR crane with the ballast disconnected."},{"id":1763,"caption":null,"alternativeText":"Hoeflon C6e BR crane in transport position"},{"id":1767,"caption":null,"alternativeText":"C6e with crane lifting an IBC tank"},{"id":1762,"caption":null,"alternativeText":"C6e articulated arm with vacuum lifter"},{"id":1761,"caption":null,"alternativeText":"C6e with extendable stabilizing legs in action."},{"id":1760,"caption":null,"alternativeText":"C6e on trailer with the machine in folded position."},{"id":1759,"caption":null,"alternativeText":"C6e with crane lifting an IBC tank"},{"id":1758,"caption":null,"alternativeText":"C6e with retracting stabilizers."},{"id":1757,"caption":null,"alternativeText":"C6e crane with glass suction lifter lifting a glass panel, in working position."},{"id":1755,